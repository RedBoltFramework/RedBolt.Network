<Project>
  <!--
    Module project evaluation. Native module with a generator, an Android native project, and a
    custom web extension script.
  -->
  <PropertyGroup>
    <RedBoltNetworkRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltNetworkRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltNetworkRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltExternalModuleRoot>$(RedBoltNetworkRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.Network</RedBoltExternalModuleName>
    <RedBoltExternalGeneratorProjectName>RedBolt.Network.Generator.Dependencies</RedBoltExternalGeneratorProjectName>
    <RedBoltExternalGeneratorProjectPrefix>RedBolt.Network.Generator.</RedBoltExternalGeneratorProjectPrefix>
    <RedBoltExternalGeneratedBindingsDirectory>redbolt-network-native</RedBoltExternalGeneratedBindingsDirectory>
    <RedBoltExternalBindingsSubdirectory>libdatachannel</RedBoltExternalBindingsSubdirectory>
    <RedBoltExternalBindingsProjectName>RedBolt.Bindings.LibDataChannel</RedBoltExternalBindingsProjectName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
    <RedBoltExternalWebNativeEnabled>false</RedBoltExternalWebNativeEnabled>
    <RedBoltExternalNativeTargetPrefix>redbolt-network</RedBoltExternalNativeTargetPrefix>
    <RedBoltExternalEnabledNativeModules>LIBDATACHANNEL</RedBoltExternalEnabledNativeModules>
    <RedBoltWebExtensionScript>$(RedBoltNetworkRoot)/src/RedBolt/Sample/Web/wwwroot/extension.js</RedBoltWebExtensionScript>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Directory.Build.props" />
  <PropertyGroup>
    <RedBoltExternalAndroidNativeOutput>$(RedBoltNativeOutputRoot)</RedBoltExternalAndroidNativeOutput>
  </PropertyGroup>
</Project>
