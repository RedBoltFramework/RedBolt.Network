<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <_RedBoltExternalDesktopProject Include="../Native/RedBolt.Network.Native.csproj;../Native/LibDataChannel/RedBolt.Bindings.LibDataChannel.csproj;../Network/RedBolt.Network.csproj" Condition="'$(RedBoltNetworkEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Sample/*/*.csproj" Exclude="../Sample/Android/*.csproj;../Sample/Web/*.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="$(RedBoltTestsProject)" Condition="'$(RedBoltTestsEnabled)' == 'true' and Exists('$(RedBoltTestsProject)')" />
    <_RedBoltExternalAndroidProject Include="../Native/RedBolt.Network.Native.Android.csproj;../Native/LibDataChannel/RedBolt.Bindings.LibDataChannel.csproj;../Network/RedBolt.Network.csproj" Condition="'$(RedBoltNetworkEnabled)' == 'true'" />
    <_RedBoltExternalAndroidProject Include="../Sample/Android/RedBolt.Sample.Android.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalWebProject Include="../Network/RedBolt.Network.csproj" Condition="'$(RedBoltNetworkEnabled)' == 'true'" />
    <_RedBoltExternalWebProject Include="../Sample/Web/RedBolt.Sample.Web.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Build.targets" />
</Project>
