<Project>
  <PropertyGroup>
    <RedBoltNetworkEnabled Condition="$([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',all,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',network,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',physics-2d,'))">true</RedBoltNetworkEnabled>
    <RedBoltNetworkEnabled Condition="'$(RedBoltNetworkEnabled)' == '' and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',all,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',network,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',physics-2d,'))">true</RedBoltNetworkEnabled>
    <RedBoltNetworkEnabled Condition="'$(RedBoltNetworkEnabled)' == ''">false</RedBoltNetworkEnabled>
  </PropertyGroup>
</Project>
